# Everything listed here stays out of the .vsix. The package should hold only
# dist/, media/, themes/, package.json, README.md and CHANGELOG.md.
# vsce keeps a file if ANY "!" negation matches it, regardless of order, so add
# negations sparingly and keep them narrow.
.vscode/**
.vscode-test/**
.claude/**
.copirate/**
.github/**
src/**
test/**
scripts/**
docs/**
out/**
coverage/**
node_modules/**
**/*.map
**/*.ts
esbuild.js
eslint.config.mjs
jest.config.js
tsconfig*.json
package-lock.json
.gitignore
.mcp.json
AGENTS.md
*.vsix
# README screenshot. The README links it by its absolute raw.githubusercontent.com URL, so
# GitHub, the Marketplace page and VS Code's Extensions view all load it from the repository
# once it is pushed, and the package does not need a copy.
images/**
# Full-size logo source (about 1 MB). The package ships media/icon.png, a 256 px copy, instead.
media/gigglybits.png
