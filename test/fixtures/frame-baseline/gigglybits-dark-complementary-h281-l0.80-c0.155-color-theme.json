        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#e9da75"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#e8eafe"
      }
    },
    {
      "name": "Comment",
