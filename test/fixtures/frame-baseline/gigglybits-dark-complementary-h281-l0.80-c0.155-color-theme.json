      ],
      "settings": {
        "foreground": "#b2b6fd"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#d0d4fe"
      }
    },
    {
      "name": "String",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#d4c02d"
      }
    },
    {
      "name": "Type",
      "scope": [
